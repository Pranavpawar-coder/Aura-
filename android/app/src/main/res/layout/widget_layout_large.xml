<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Top: Artwork Area with Badges Overlay -->
    <FrameLayout
        android:id="@+id/widget_artwork_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ImageView
            android:id="@+id/widget_artwork"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/aura_logo"
            android:contentDescription="@string/app_name" />

        <!-- Top-Left Pill Badge: Lossless / Format Badge -->
        <LinearLayout
            android:id="@+id/widget_badge_lossless_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="10dp"
            android:background="@drawable/widget_pill_badge_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp">

            <View
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/widget_button_play_pause" />

            <TextView
                android:id="@+id/widget_quality_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="24-BIT / 96kHz LOSSLESS"
                android:textColor="@color/widget_text_primary"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Bottom-Right Pill Badge: Spatial Audio / 4D -->
        <TextView
            android:id="@+id/widget_badge_spatial"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="10dp"
            android:background="@drawable/widget_pill_badge_bg"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp"
            android:text="SPATIAL AUDIO"
            android:textColor="@color/widget_text_primary"
            android:textSize="9sp"
            android:textStyle="bold" />
    </FrameLayout>

    <!-- Track Metadata & Secondary Actions (Title, Artist, Heart, Lyrics) -->
    <LinearLayout
        android:id="@+id/widget_meta_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/widget_text_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_track_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_idle_title"
                android:textColor="@color/widget_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_track_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_idle_artist"
                android:textColor="@color/widget_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Favorite Button -->
        <ImageButton
            android:id="@+id/widget_btn_favorite"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/widget_button_control"
            android:contentDescription="@string/app_name"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_heart" />

        <!-- Lyrics Pill Button -->
        <TextView
            android:id="@+id/widget_btn_lyrics"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_lyrics_pill_bg"
            android:paddingStart="12dp"
            android:paddingTop="7dp"
            android:paddingEnd="12dp"
            android:paddingBottom="7dp"
            android:text="❝ LYRICS"
            android:textColor="@color/widget_text_primary"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Scrubber / Progress Bar Row -->
    <LinearLayout
        android:id="@+id/widget_progress_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical">

        <ProgressBar
            android:id="@+id/widget_progress_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:max="1000"
            android:progress="0"
            android:progressDrawable="@drawable/widget_progress_bar" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp">

            <TextView
                android:id="@+id/widget_time_current"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:text="0:00"
                android:textColor="@color/widget_text_muted"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/widget_time_total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="-0:00"
                android:textColor="@color/widget_text_muted"
                android:textSize="11sp" />
        </RelativeLayout>
    </LinearLayout>

    <!-- Main Playback Controls: Shuffle, Prev, Large Play/Pause, Next, Repeat -->
    <LinearLayout
        android:id="@+id/widget_controls_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/widget_btn_shuffle"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/widget_button_control"
            android:contentDescription="Shuffle"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_shuffle" />

        <ImageButton
            android:id="@+id/widget_btn_previous"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="16dp"
            android:background="@drawable/widget_button_control"
            android:contentDescription="@string/widget_action_previous"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_skip_previous" />

        <ImageButton
            android:id="@+id/widget_btn_play_pause"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/widget_button_play_pause"
            android:contentDescription="@string/widget_action_play_pause"
            android:padding="14dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_play" />

        <ImageButton
            android:id="@+id/widget_btn_next"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/widget_button_control"
            android:contentDescription="@string/widget_action_next"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_skip_next" />

        <ImageButton
            android:id="@+id/widget_btn_repeat"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/widget_button_control"
            android:contentDescription="Repeat"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_repeat" />
    </LinearLayout>

    <!-- Bottom Secondary Info Card 1: DEVICE OUTPUT -->
    <LinearLayout
        android:id="@+id/widget_card_device_output"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/widget_card_secondary_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_widget_device_output"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="DEVICE OUTPUT"
                android:textColor="@color/widget_text_muted"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_output_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="AURA SoundStage Pro • Bit-Perfect"
                android:textColor="@color/widget_text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Secondary Info Card 2: UP NEXT -->
    <LinearLayout
        android:id="@+id/widget_card_up_next"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:background="@drawable/widget_card_secondary_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp">

        <TextView
            android:id="@+id/widget_up_next_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="UP NEXT: Tap to view queue"
            android:textColor="@color/widget_text_secondary"
            android:textSize="11sp" />
    </LinearLayout>

</LinearLayout>
